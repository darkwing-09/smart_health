# ── Required ──────────────────────────────────────────────────────────────
FITAGENT_ENV=production
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
POSTGRES_PASSWORD=

# ── AI coach (optional — without a key the coach runs on deterministic rules) ──
# provider:model — anthropic:..., openai:..., google_genai:...
FITAGENT_MODEL=anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# ── LangSmith tracing & evals (optional) ──────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=fitagent

# ── Tuning ────────────────────────────────────────────────────────────────
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_COACH_PER_MIN=15
RATE_LIMIT_PLAN_PER_HOUR=10
# JSON list, only needed for browser clients
CORS_ORIGINS=[]
API_PORT=8000

# ── Android App Links for challenge invites (release only) ──────────────────
ANDROID_PACKAGE=com.fitagent.app
# keytool -list -v -keystore release.jks → SHA-256 fingerprint(s), comma-separated
ANDROID_CERT_SHA256=

# ── Daily report on WhatsApp (optional — without a token reports are saved to REPORT_DIR) ──
# Meta WhatsApp Cloud API: developers.facebook.com → your app → WhatsApp → API setup. See docs/WHATSAPP_REPORTS.md
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved message template with a DOCUMENT header and body "Your FitAgent report: {{1}}"
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v21.0
REPORT_DIR=./reports
REPORT_JOB_INTERVAL_S=600
