# ==============================================================================
# Personal Health OS — Canonical Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env AND POPULATE WITH ENVIRONMENT CREDENTIALS.
# NEVER COMMIT REAL KEYS OR PASSWORDS TO SOURCE CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & ENVIRONMENT RUNTIME
# ------------------------------------------------------------------------------
# Options: development | test | staging | production
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","https://app.healthos.local"]
ANDROID_APP_ID=com.healthos.android

# ------------------------------------------------------------------------------
# 2. CRYPTOGRAPHIC KEYS & AUTHENTICATION
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=replace_with_64_character_hex_string_for_jwt_signing_secret_key_000000
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# 32-byte Base64 key for database AES-256-GCM field encryption.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY_AES256=replace_with_base64_encoded_32_byte_aes_encryption_key_here=
ENCRYPTION_KEY_ID=v1
# JSON dictionary of old keys for seamless key rotation: e.g. {"v0": "old_base64_key..."}
ENCRYPTION_OLD_KEYS_JSON={}

# Rate Limiting (Redis-backed token bucket)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_SYNC_PER_MIN=60
RATE_LIMIT_SUMMARY_PER_MIN=10
RATE_LIMIT_EXPORT_PER_MIN=10


# ------------------------------------------------------------------------------
# 3. DATABASE & PERSISTENCE INFRASTRUCTURE
# ------------------------------------------------------------------------------
# PostgreSQL 16 connection string with asyncpg driver (TimescaleDB hypertable)
DATABASE_URL=postgresql+asyncpg://healthos_user:healthos_dev_password@localhost:5432/healthos_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis 7 for ARQ worker queue, cadence scheduling, and caching
REDIS_URL=redis://localhost:6379/0

# Object storage for daily PDF digests (local | s3 | gcs)
STORAGE_PROVIDER=local
STORAGE_BUCKET=healthos-daily-reports
STORAGE_LOCAL_PATH=./data/reports

# ------------------------------------------------------------------------------
# 4. DETERMINISTIC ANALYTICS & PHYSIOLOGICAL GATES
# ------------------------------------------------------------------------------
BASELINE_MIN_DAYS_ESTABLISHED=14
BASELINE_ROLLING_WINDOW_DAYS=30

# Z-Score deviation thresholds against personal baseline
ANOMALY_ZSCORE_UNUSUAL=2.0
ANOMALY_ZSCORE_MONITORING=2.8
ANOMALY_ZSCORE_CONCERNING=3.8
ANOMALY_ZSCORE_URGENT=5.0

# Hard biological boundary gates (bpm) triggering Level 4 Urgent evaluation
HARD_PHYSIO_HR_MAX=150.0
HARD_PHYSIO_HR_MIN=38.0

# Anti-fatigue deduplication window (hours)
NOTIFICATION_DEDUP_WINDOW_HOURS=12

# ------------------------------------------------------------------------------
# 5. AI AGENTS & LLM PROVIDERS
# ------------------------------------------------------------------------------
# Options: openai | anthropic
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=sk-proj-replace_with_real_openai_api_key_here
ANTHROPIC_API_KEY=sk-ant-replace_with_real_anthropic_api_key_here

LLM_MODEL_HEALTH_INTEL=gpt-4o
LLM_MODEL_DAILY_REPORT=gpt-4o
LLM_TEMPERATURE_HEALTH_INTEL=0.1
LLM_MAX_TOKENS_HEALTH_INTEL=1000

# ------------------------------------------------------------------------------
# 6. LANGSMITH TRACING, EVALUATION & OBSERVABILITY
# ------------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_replace_with_real_langsmith_api_key_here
LANGCHAIN_PROJECT=personal-health-os
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ------------------------------------------------------------------------------
# 7. NOTIFICATION CHANNELS (FCM & WHATSAPP)
# ------------------------------------------------------------------------------
# Firebase Cloud Messaging (FCM HTTP v1 API)
FCM_PROJECT_ID=personal-health-os-firebase-dev
FCM_CREDENTIALS_JSON=replace_with_base64_encoded_firebase_admin_service_account_json

# WhatsApp Business Cloud API (DEFERRED FOR MVP — V1 INTEGRATION)
WHATSAPP_PROVIDER=meta_cloud_api
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=EAAG...replace_with_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=109283746592019
WHATSAPP_WABA_ID=982736451029384

# ------------------------------------------------------------------------------
# 8. THIRD-PARTY DIRECTORY & CARE NAVIGATION
# ------------------------------------------------------------------------------
# Options: mock | google_places | osm
PLACES_PROVIDER=mock
GOOGLE_PLACES_API_KEY=AIzaSy...replace_with_google_places_api_key
CARE_SEARCH_RADIUS_KM=10

# ------------------------------------------------------------------------------
# 9. STRUCTURED LOGGING & APM TELEMETRY
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
SENTRY_DSN=https://example_public_key@sentry.io/project_id_placeholder
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
